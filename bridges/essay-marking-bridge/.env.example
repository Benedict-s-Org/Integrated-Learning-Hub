# ==============================================================================
# Essay Marking Bridge — Environment Configuration
# Copy this file to '.env' in this directory.
# NEVER commit '.env' to version control.
# ==============================================================================

# Server Network Settings
PORT=18089
HOST=127.0.0.1

# Allowed Origins for CORS (comma-separated, local Vite frontend)
ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# ==============================================================================
# 1. Supabase Authentication & Role Verification (Mandatory)
# Used server-side to verify JWT session tokens and ensure caller has 'admin'
# or 'class_staff' teacher privileges. Fails closed (503) if not configured.
# ==============================================================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional: Service role key if database users table requires elevated privileges
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# 2. Mathpix OCR API Credentials
# ==============================================================================
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# ==============================================================================
# 3. Safety Guard: DRY_RUN
# Set to 'false' only after explicitly authorizing live paid Mathpix API calls.
# When 'true', the bridge validates authentication, verifies image payloads,
# but halts with an explicit dry-run notice before calling Mathpix.
# ==============================================================================
DRY_RUN=true

# ==============================================================================
# 4. Request, Image & Concurrency Limits
# Initial live test is constrained to 1 page to prevent accidental billing.
# ==============================================================================
MAX_PAGES_PER_REQUEST=1
MAX_IMAGE_SIZE_MB=8
MAX_TOTAL_REQUEST_SIZE_MB=15
MAX_UPLOAD_SIZE_MB=25
MAX_CONCURRENT_JOBS=1
JOB_RETENTION_WINDOW_MS=300000
REQUEST_TIMEOUT_MS=45000

# Upstream Vision Model (Reserved for later phase — DO NOT MODIFY YET)
QWEN_VL_ENDPOINT=http://127.0.0.1:18088
